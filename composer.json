{
    "name": "bluefission/synthetiq",
    "description": "Adaptive conversational AI system",
    "license": "MIT",
    "keywords": ["synthetiq", "ai", "nlp", "machine learning", "chatbot", "bot", "communication", "natural language processing"],
    "authors": [
        {
            "name": "Devon Scott",
            "email": "dscott@bluefission.com",
            "homepage": "https://bluefission.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bluefission/develation"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bluefission/automata"
        },
        {
            "type": "vcs",
            "url": "https://github.com/BlueFissionTech/simpleclients"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.2",
        "bluefission/develation": "^1.0.0-alpha",
        "bluefission/automata": "dev-master",
        "bluefission/simpleclients": "dev-master",
        "php-ai/php-ml": "^0.10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.1@dev"
    },
    "autoload": {
        "psr-4": {
            "BlueFission\\SynthetIQ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": { 
            "BlueFission\\SynthetIQ\\Tests\\": "tests/" 
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
